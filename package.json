{
  "name": "arch-ai-official-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "deploy": "npm run build && node --env-file=.env.local scripts/deploy.mjs",
    "vercel": "node --env-file=.env.local scripts/vercel.mjs",
    "start": "next start",
    "lint": "next lint",
    "db:migrate-local": "node --env-file=.env.local scripts/migrate-local-data.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit --incremental false"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.2",
    "next": "16.2.10",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "stripe": "^22.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "22.15.30",
    "@types/react": "19.0.12",
    "@types/react-dom": "19.0.4",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.16",
    "tailwindcss": "3.4.17",
    "tsx": "^4.23.13",
    "typescript": "5.8.3"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.16"
    }
  }
}
