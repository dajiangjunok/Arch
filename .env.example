NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Calendar appointment schedule shown to interview-invited applicants.
GOOGLE_CALENDAR_BOOKING_URL=

STRIPE_SECRET_KEY= 
STRIPE_WEBHOOK_SECRET= 

# Stripe webhook endpoint: https://YOUR_DOMAIN/api/stripe/webhook
# Required events are listed in docs/stripe-refunds.md.

# Preferred: configure Stripe Price IDs in Dashboard and paste them here.
STRIPE_PRICE_SINGLE_WEEK= 
STRIPE_PRICE_TWO_WEEKS= 
STRIPE_PRICE_FULL_PROGRAM= 
STRIPE_PRICE_FELLOWSHIP=

# Alternative: let the server create dynamic Stripe price_data from these amounts.
# Amounts are in the smallest currency unit, e.g. cents for USD.
ARCH_PAYMENT_CURRENCY=usd
ARCH_TICKET_AMOUNT_SINGLE_WEEK=979900
ARCH_TICKET_AMOUNT_TWO_WEEKS=1959800
ARCH_TICKET_AMOUNT_FULL_PROGRAM=2939700
ARCH_TICKET_AMOUNT_FELLOWSHIP=

# Legacy local data file path.
ARCH_DATA_FILE=.data/arch-data.json

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Enable Email provider in Supabase Auth. Add /auth/callback to the allowed redirect URLs.

# Cloudflare Turnstile protects sign-up, sign-in and confirmation email requests.
# Configure both values in the same production environment, then redeploy.
# The site key is read on the server and passed to the widget at request time.
# Local development uses Cloudflare's official test keys when these are empty.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Legacy aliases such as NEXT_PUBLIC_TURNSTILE_SITE_KEY and the
# CLOUDFLARE_TURNSTILE_* names are also supported.

# Server only. Never expose this value to browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Optional direct Postgres connections for database tooling and migrations.
DATABASE_URL=
DIRECT_URL=
