ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

STRIPE_SECRET_KEY= 
STRIPE_WEBHOOK_SECRET= 

# Preferred: configure Stripe Price IDs in Dashboard and paste them here.
STRIPE_PRICE_FULL_PROGRAM=
STRIPE_PRICE_WEEK_1=
STRIPE_PRICE_WEEK_2=
STRIPE_PRICE_WEEK_3=
STRIPE_PRICE_DEPOSIT=

# Alternative: let the server create dynamic Stripe price_data from these amounts.
# Amounts are in the smallest currency unit, e.g. cents for USD.
ARCH_PAYMENT_CURRENCY=usd
ARCH_TICKET_AMOUNT_FULL_PROGRAM=
ARCH_TICKET_AMOUNT_WEEK_1=
ARCH_TICKET_AMOUNT_WEEK_2=
ARCH_TICKET_AMOUNT_WEEK_3=
ARCH_TICKET_AMOUNT_DEPOSIT=

# Legacy local data file path.
ARCH_DATA_FILE=.data/arch-data.json

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Enable Email provider in Supabase Auth. Add /auth/callback to the allowed redirect URLs.

# Cloudflare Turnstile protects sign-up, sign-in and confirmation email requests.
# Local development uses Cloudflare's official test keys when these are empty.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Server only. Never expose this value to browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Optional direct Postgres connections for database tooling and migrations.
DATABASE_URL=
DIRECT_URL=
